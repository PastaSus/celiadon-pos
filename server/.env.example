# PostgreSQL connection string. Neon requires ?sslmode=require.
# Local dev: copy this file to server/.env and fill in values.
# On Vercel: set DATABASE_URL (and JWT_SECRET) in the project dashboard or
# via the Neon integration — the integration injects POSTGRES_URL, which the
# server also accepts as a fallback (see db.ts). Never commit real credentials.
DATABASE_URL=postgresql://user:password@host:5432/pos_system?sslmode=require

# Secret used to sign JWTs. Generate a long random value for anything deployed.
JWT_SECRET=replace-me-with-a-long-random-secret

# Optional: token lifetime, passed to jsonwebtoken. Defaults to 7d.
JWT_EXPIRES_IN=7d

# Optional: HTTP port. Defaults to 5000.
PORT=5000